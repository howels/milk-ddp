wavecode_3_enabled=0
wave_0_per_point1=x = sample * 0.96 + 0.02;
wave_0_per_point2=y = 0.12 + value * 0.65;
wave_0_per_point3=r = 0.6 + 0.4 * bass_att + 0.5 * sample;
wave_0_per_point4=g = 0.05 + 0.4 * mid_att;
wave_0_per_point5=b = 0.7 + 0.3 * treb_att + 0.3 * (1 - sample);
wave_0_per_point6=a = 0.75 + 0.25 * value;
wave_1_per_point1=x = sample * 0.96 + 0.02;
wave_1_per_point2=y = 0.88 - value * 0.45;
wave_1_per_point3=r = 0.05 + 0.3 * bass;
wave_1_per_point4=g = 0.7 + 0.3 * mid_att;
wave_1_per_point5=b = 0.8 + 0.2 * treb;
wave_1_per_point6=a = 0.7 + 0.3 * value;
wave_2_per_point1=x = 0.5 + 0.42 * cos(sample * 6.2832 + time);
wave_2_per_point2=y = 0.5 + 0.42 * sin(sample * 6.2832 + time) * (0.4 + 0.6 * value);
wave_2_per_point3=r = 1.0;
wave_2_per_point4=g = 0.85 + 0.15 * treb_att;
wave_2_per_point5=b = 0.1 + 0.4 * mid;
wave_2_per_point6=a = 0.55 + 0.45 * value;
per_frame_1=dt = min(max(time - tl, 0.004), 0.08); tl = time;
per_frame_2=bm = bm + (bass - bm) * (1 - exp(-dt / 0.45));
per_frame_3=bd = bd + (abs(bass - bm) - bd) * (1 - exp(-dt / 1.5));
per_frame_4=hit = min(max(((bass - bm) / max(bd, 0.06) - 0.5) / 1.1, 0), 1);
per_frame_5=kick = max(kick * pow(0.80, 60 * dt), hit);
per_frame_6=k60 = pow(0.90, 60 * dt);
per_frame_7=sb = sb * k60 + bass_att * (1 - k60);
per_frame_8=sm = sm * k60 + mid_att * (1 - k60);
per_frame_9=st = st * k60 + treb_att * (1 - k60);
per_frame_10=ang = ang + dt * (0.3500 + 0.5500 * st + 0.15 * kick);
per_frame_11=scroll = scroll + dt * (0.3000 + 0.35 * st + 0.2 * sb);
per_frame_12=hue_shift = 0.0800 + 0.12 * time + 0.18 * st - 0.08 * sb + 0.05 * kick; hue_shift = hue_shift - int(hue_shift);
per_frame_13=ib_a = 0.25 + 0.45 * st + 0.25 * kick;
per_frame_14=ib_r = 0.1 + 0.7 * st; ib_g = 0.7 + 0.3 * sm; ib_b = 1.0;
per_frame_15=wave_r = min(0.4 + 0.8 * sb + 0.5 * kick, 1);
per_frame_16=wave_g = min(0.15 + 0.7 * sm + 0.4 * st, 1);
per_frame_17=wave_b = min(0.5 + 0.7 * st + 0.3 * sm, 1);
per_frame_18=q1 = kick; q2 = sb; q3 = sm; q4 = st; q5 = ang;
per_frame_19=q6 = scroll; q7 = 0.0800; q8 = 1.0000; q9 = 0.0100; q10 = 18.0000;
per_frame_20=q11 = hue_shift; q12 = min(0.85 + 0.25 * (sb+sm+st), 1.15); q13 = 0.78 + 0.18 * (sb+sm+st);
warp_1=`float2 rot2(float2 p, float a)
warp_2=`{
warp_3=`  float c = cos(a); float s = sin(a);
warp_4=`  return float2(c*p.x - s*p.y, s*p.x + c*p.y);
warp_5=`}
warp_6=`float3 neon_hue(float h)
warp_7=`{
warp_8=`  float3 k = abs(frac(h + float3(0.0, 0.66667, 0.33333))*6.0 - 3.0) - 1.0;
warp_9=`  return saturate(k);
warp_10=`}
warp_11=`float3 neon_mix(float u)
warp_12=`{
warp_13=`  float h = frac(q11 + u * 0.35 + 0.15 * q4);
warp_14=`  float3 c = neon_hue(h);
warp_15=`  c = lerp(c, float3(1.0, 0.05, 0.85), saturate(q2 * 0.55));
warp_16=`  c = lerp(c, float3(0.05, 1.0, 0.55), saturate(q3 * 0.45));
warp_17=`  c = lerp(c, float3(0.1, 0.85, 1.0), saturate(q4 * 0.55));
warp_18=`  return saturate(c);
warp_19=`}
warp_20=`float glow_line(float d, float w)
warp_21=`{
warp_22=`  return exp(-abs(d) / max(w, 0.001));
warp_23=`}
warp_24=`float3 led_tonemap(float3 col)
warp_25=`{
warp_26=`  float lum = max(dot(col, float3(0.30, 0.59, 0.11)), 0.0001);
warp_27=`  float mapped = 1.0 - exp(-lum * 0.95);
warp_28=`  mapped = min(mapped, 0.92);
warp_29=`  float3 outc = (col / lum) * mapped * q13;
warp_30=`  outc += float3(1.0, 1.0, 1.0) * pow(mapped, 3.0) * q1 * 0.65;
warp_31=`  return saturate(outc);
warp_32=`}
warp_33=`shader_body
warp_34=`{
warp_35=`  float2 p = (uv - 0.5);
warp_36=`  float2 suv = uv + p * (-0.01 - 0.02 * q1) + float2(0.003 * q4, -0.002 * q2);
warp_37=`  float3 prev = tex2D(sampler_main, suv).rgb * (0.86 + 0.04 * q2);
warp_38=`  float3 ink = tex2D(sampler_main, uv).rgb;
warp_39=`  ret = max(prev, ink * (1.0 + 0.2 * q1));
warp_40=`  ret = max(ret - 0.0015, 0.0);
warp_41=`}
comp_1=`float2 rot2(float2 p, float a)
comp_2=`{
comp_3=`  float c = cos(a); float s = sin(a);
comp_4=`  return float2(c*p.x - s*p.y, s*p.x + c*p.y);
comp_5=`}
comp_6=`float3 neon_hue(float h)
comp_7=`{
comp_8=`  float3 k = abs(frac(h + float3(0.0, 0.66667, 0.33333))*6.0 - 3.0) - 1.0;
comp_9=`  return saturate(k);
comp_10=`}
comp_11=`float3 neon_mix(float u)
comp_12=`{
comp_13=`  float h = frac(q11 + u * 0.35 + 0.15 * q4);
comp_14=`  float3 c = neon_hue(h);
comp_15=`  c = lerp(c, float3(1.0, 0.05, 0.85), saturate(q2 * 0.55));
comp_16=`  c = lerp(c, float3(0.05, 1.0, 0.55), saturate(q3 * 0.45));
comp_17=`  c = lerp(c, float3(0.1, 0.85, 1.0), saturate(q4 * 0.55));
comp_18=`  return saturate(c);
comp_19=`}
comp_20=`float glow_line(float d, float w)
comp_21=`{
comp_22=`  return exp(-abs(d) / max(w, 0.001));
comp_23=`}
comp_24=`float3 led_tonemap(float3 col)
comp_25=`{
comp_26=`  float lum = max(dot(col, float3(0.30, 0.59, 0.11)), 0.0001);
comp_27=`  float mapped = 1.0 - exp(-lum * 0.95);
comp_28=`  mapped = min(mapped, 0.92);
comp_29=`  float3 outc = (col / lum) * mapped * q13;
comp_30=`  outc += float3(1.0, 1.0, 1.0) * pow(mapped, 3.0) * q1 * 0.65;
comp_31=`  return saturate(outc);
comp_32=`}
comp_33=`shader_body
comp_34=`{
comp_35=`  float ar = texsize.x * texsize.w;
comp_36=`  float2 p = (uv - 0.5) * float2(ar, 1.0);
comp_37=`  float2 r = rot2(p, q5);
comp_38=`  float theta = atan2(r.y, r.x);
comp_39=`  float rr = length(r);
comp_40=`  float spokes = abs(frac(theta / 6.2832 * q10 + q6) - 0.5);
comp_41=`  float beam = glow_line(spokes, q9 * (0.5 + 0.45 * q1 + 0.25 * q4));
comp_42=`  beam *= smoothstep(1.2, 0.05, rr);
comp_43=`  float rings = glow_line(frac(rr * (6.0 + 4.0 * q2) - q6 * 2.0) - 0.5, 0.03 + 0.02 * q3);
comp_44=`  float3 col = neon_mix(theta * 0.15) * beam * (1.05 + 0.35 * q1);
comp_45=`  col += neon_hue(q11 + 0.33) * rings * (0.45 + 0.4 * q3);
comp_46=`  col += neon_hue(q11) * exp(-rr * 4.0) * (0.25 + 0.35 * q1);
comp_47=`  float3 tex = tex2D(sampler_main, uv).rgb;
comp_48=`  col += tex * neon_mix(uv.y) * 0.25;
comp_49=`  ret = led_tonemap(col);
comp_50=`}
