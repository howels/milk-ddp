comp_41=`  float mapped = 1.0 - exp(-lum * 0.95);
comp_42=`  mapped = min(mapped, 0.82);
comp_43=`  float3 outc = (col / lum) * mapped * q13;
comp_44=`  outc += col * pow(mapped, 2.5) * q1 * 0.12;
comp_45=`  return saturate(outc);
comp_46=`}
comp_47=`float3 studio_env(float3 R)
comp_48=`{
comp_49=`  float u = R.y;
comp_50=`  float3 sky = lerp(float3(0.55, 0.42, 0.22), float3(0.18, 0.16, 0.28), saturate(0.3 + u * 0.55));
comp_51=`  float3 gnd = lerp(float3(0.02, 0.015, 0.01), float3(0.12, 0.08, 0.05), saturate(0.25 - u * 0.5));
comp_52=`  float3 env = lerp(gnd, sky, smoothstep(-0.2, 0.18, u));
comp_53=`  float box1 = pow(saturate(sin(R.x * 3.2 + R.z * 1.1 + q9 * 0.35)), 14.0);
comp_54=`  float box2 = pow(saturate(sin(R.x * -2.0 + R.y * 3.5 - q9 * 0.2)), 20.0);
comp_55=`  env += float3(0.85, 0.55, 0.18) * box1 * 0.55;
comp_56=`  env += float3(0.35, 0.55, 0.45) * box2 * 0.4;
comp_57=`  env += float3(0.4, 0.25, 0.55) * pow(saturate(-R.x * 0.45 + 0.15), 3.5) * 0.2;
comp_58=`  return env;
comp_59=`}
comp_60=`float3 heat_temper(float u)
comp_61=`{
