wave_0_per_point1=x = 0.5 + (0.04 + 0.24 * value + 0.08 * bass_att) * cos(sample * 6.2832);
wave_0_per_point2=y = 0.5 + (0.04 + 0.24 * value + 0.08 * bass_att) * sin(sample * 6.2832);
wave_0_per_point3=r = 0.15 + 0.95 * bass_att + 0.7 * sample;
wave_0_per_point4=g = 0.15 + 0.95 * mid_att + 0.45 * value;
wave_0_per_point5=b = 0.2 + 0.95 * treb_att + 0.55 * (1 - sample);
wave_0_per_point6=a = 0.75 + 0.25 * value;
wave_1_per_point1=x = 0.5 + (0.02 + 0.15 * value + 0.05 * mid_att) * cos(sample * 6.2832 + time * 0.4);
wave_1_per_point2=y = 0.5 + (0.02 + 0.15 * value + 0.05 * mid_att) * sin(sample * 6.2832 + time * 0.4);
wave_1_per_point3=r = 0.9 + 0.1 * bass - 0.5 * sample;
wave_1_per_point4=g = 0.25 + 0.75 * mid_att + 0.4 * sample;
wave_1_per_point5=b = 0.3 + 0.7 * treb_att;
wave_1_per_point6=a = 0.7 + 0.3 * value;
wave_2_per_point1=x = 0.5 + (0.07 + 0.3 * value) * cos(sample * 6.2832 - time * 0.3);
wave_2_per_point2=y = 0.5 + (0.07 + 0.3 * value) * sin(sample * 6.2832 - time * 0.3) * (0.85 + 0.15 * value);
wave_2_per_point3=r = 0.2 + 0.6 * treb_att + 0.5 * (1 - sample);
wave_2_per_point4=g = 0.35 + 0.65 * mid_att + 0.35 * sample;
wave_2_per_point5=b = 0.5 + 0.5 * bass_att + 0.4 * sample;
wave_2_per_point6=a = 0.7 + 0.3 * value;
wave_3_per_point1=x = 0.5 + (0.01 + 0.11 * value) * cos(sample * 12.5664);
wave_3_per_point2=y = 0.5 + (0.01 + 0.11 * value) * sin(sample * 12.5664);
wave_3_per_point3=r = 0.55 + 0.45 * sample;
wave_3_per_point4=g = 0.3 + 0.5 * mid + 0.3 * (1 - sample);
wave_3_per_point5=b = 0.8 + 0.2 * treb;
wave_3_per_point6=a = 0.65 + 0.35 * value;

per_frame_1=dt = min(max(time - tl, 0.004), 0.08); tl = time;
per_frame_2=bm = bm + (bass - bm) * (1 - exp(-dt / 0.5));
per_frame_3=bd = bd + (abs(bass - bm) - bd) * (1 - exp(-dt / 1.6));
per_frame_4=hit = min(max(((bass - bm) / max(bd, 0.06) - 0.55) / 1.2, 0), 1);
per_frame_5=kick = max(kick * pow(0.88, 60 * dt), hit * 0.65);
per_frame_6=k60 = pow(0.9, 60 * dt);
per_frame_7=sb = sb * k60 + bass_att * (1 - k60);
per_frame_8=sm = sm * k60 + mid_att * (1 - k60);
per_frame_9=st = st * k60 + treb_att * (1 - k60);
per_frame_10=ang = ang + dt * (0.0150 + 0.0600 * st);
per_frame_11=depth = depth + dt * (0.5000 + 0.3000 * sb);
per_frame_12=pull = 0.9830 - 0.0060 * sb - 0.0100 * kick;
per_frame_13=scroll = 0.0100 + 0.0040 * sb + 0.0060 * kick;
per_frame_14=hue_shift = 0.7200 + 0.06 * time + 0.1 * st - 0.04 * sb; hue_shift = hue_shift - int(hue_shift);
per_frame_15=wave_r = min(0.7 + 0.3 * sb, 1);
per_frame_16=wave_g = min(0.65 + 0.35 * sm, 1);
per_frame_17=wave_b = min(0.6 + 0.4 * st, 1);
per_frame_18=q1 = kick; q2 = sb; q3 = sm; q4 = st; q5 = ang; q6 = depth;
per_frame_19=q11 = hue_shift; q13 = 1.0 + 0.12 * (sb + sm + st) * 0.25;
per_frame_20=q15 = scroll; q16 = pull;
warp_1=`float3 hue(float h, float s)
warp_2=`{
warp_3=`  float3 k = abs(frac(h + float3(0.0, 0.66667, 0.33333))*6.0 - 3.0) - 1.0;
warp_4=`  return (1.0 - s) + s*saturate(k);
warp_5=`}
warp_6=`float3 sharp(float2 tc)
warp_7=`{
warp_8=`  return tex2D(sampler_main, saturate(tc)).rgb;
warp_9=`}
warp_10=`float lum3(float3 c)
warp_11=`{
warp_12=`  return dot(c, float3(0.30, 0.59, 0.11));
warp_13=`}
warp_14=`float3 boost_chroma(float3 c, float amt)
warp_15=`{
warp_16=`  float L = lum3(c);
warp_17=`  return saturate(L + (c - L) * amt);
warp_18=`}
warp_19=`float3 led_tonemap(float3 col)
warp_20=`{
warp_21=`  float lum = max(lum3(col), 0.0001);
warp_22=`  float mapped = 1.0 - exp(-lum * 1.1);
warp_23=`  mapped = min(mapped, 0.92);
warp_24=`  return saturate((col / lum) * mapped * q13);
warp_25=`}
warp_26=`shader_body
warp_27=`{
warp_28=`  float ar = texsize.x * texsize.w;
warp_29=`  float2 p = (uv - 0.5) * float2(ar, 1.0);
warp_30=`  float pull = saturate(q16);
warp_31=`  float2 s = p * pull;
warp_32=`  float2 suv = s / float2(ar, 1.0) + 0.5;
warp_33=`  float3 hist = sharp(suv);
warp_34=`  float keep = 0.985 - 0.01 * q1;
warp_35=`  ret = max(hist * keep - 0.0015, 0.0);
warp_36=`}
comp_1=`float3 hue(float h, float s)
comp_2=`{
comp_3=`  float3 k = abs(frac(h + float3(0.0, 0.66667, 0.33333))*6.0 - 3.0) - 1.0;
comp_4=`  return (1.0 - s) + s*saturate(k);
comp_5=`}
comp_6=`float3 sharp(float2 tc)
comp_7=`{
comp_8=`  return tex2D(sampler_main, saturate(tc)).rgb;
comp_9=`}
comp_10=`float lum3(float3 c)
comp_11=`{
comp_12=`  return dot(c, float3(0.30, 0.59, 0.11));
comp_13=`}
comp_14=`float3 boost_chroma(float3 c, float amt)
comp_15=`{
comp_16=`  float L = lum3(c);
comp_17=`  return saturate(L + (c - L) * amt);
comp_18=`}
comp_19=`float3 led_tonemap(float3 col)
comp_20=`{
comp_21=`  float lum = max(lum3(col), 0.0001);
comp_22=`  float mapped = 1.0 - exp(-lum * 1.1);
comp_23=`  mapped = min(mapped, 0.92);
comp_24=`  return saturate((col / lum) * mapped * q13);
comp_25=`}
comp_26=`shader_body
comp_27=`{
comp_28=`  float2 px = texsize.zw;
comp_29=`  float3 c = sharp(uv);
comp_30=`  float3 cx = sharp(uv + float2(px.x, 0.0));
comp_31=`  float3 cy = sharp(uv + float2(0.0, px.y));
comp_32=`  float L = lum3(c);
comp_33=`  float Lx = lum3(cx);
comp_34=`  float Ly = lum3(cy);
comp_35=`  float edge = saturate(abs(L - Lx) * 11.0 + abs(L - Ly) * 9.0);
comp_36=`  float peak = saturate((L - 0.05) * 2.2);
comp_37=`  float3 vivid = boost_chroma(c, 2.2 + 0.6 * q4);
comp_38=`  float3 col = vivid * (0.55 + 0.9 * peak);
comp_39=`  col += vivid * edge * 0.85;
comp_40=`  col += hue(q11 + L * 0.3 + uv.x * 0.2, 1.0) * pow(peak, 3.0) * 0.25 * q1;
comp_41=`  float ar = texsize.x * texsize.w;
comp_42=`  float2 p = (uv - 0.5) * float2(ar, 1.0);
comp_43=`  ret = led_tonemap(col * smoothstep(1.35, 0.12, length(p)));
comp_44=`}
