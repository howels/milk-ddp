[preset00]
MILKDROP_PRESET_VERSION=201
PSVERSION=2
PSVERSION_WARP=2
PSVERSION_COMP=2
fRating=5.000000
fGammaAdj=1.200000
fDecay=1.000000
fVideoEchoZoom=1.000000
fVideoEchoAlpha=0.000000
nVideoEchoOrientation=0
nWaveMode=5
bAdditiveWaves=0
bWaveDots=0
bWaveThick=1
bModWaveAlphaByVolume=0
bMaximizeWaveColor=1
bTexWrap=1
bDarkenCenter=0
bRedBlueStereo=0
bBrighten=0
bDarken=0
bSolarize=0
bInvert=0
fWaveAlpha=0.900000
fWaveScale=0.350000
fWaveSmoothing=0.150000
fWaveParam=0.000000
fModWaveAlphaStart=0.500000
fModWaveAlphaEnd=1.000000
fWarpAnimSpeed=1.000000
fWarpScale=1.000000
fZoomExponent=1.000000
fShader=0.000000
zoom=1.000000
rot=0.000000
cx=0.500000
cy=0.500000
dx=0.000000
dy=0.000000
warp=0.010000
sx=1.000000
sy=1.000000
wave_r=0.500000
wave_g=0.500000
wave_b=0.500000
wave_x=0.500000
wave_y=0.500000
ob_size=0.005000
ob_r=0.000000
ob_g=0.000000
ob_b=0.000000
ob_a=0.450000
ib_size=0.000000
ib_r=0.000000
ib_g=0.000000
ib_b=0.000000
ib_a=0.000000
nMotionVectorsX=0.000000
nMotionVectorsY=0.000000
mv_dx=0.000000
mv_dy=0.000000
mv_l=0.000000
mv_r=0.000000
mv_g=0.000000
mv_b=0.000000
mv_a=0.000000
per_frame_1=dt = min(max(time - tl, 0.004), 0.08); tl = time;
per_frame_2=bm = bm + (bass - bm) * (1 - exp(-dt / 0.5));
per_frame_3=bd = bd + (abs(bass - bm) - bd) * (1 - exp(-dt / 1.6));
per_frame_4=hit = min(max(((bass - bm) / max(bd, 0.06) - 0.5) / 1.1, 0), 1);
per_frame_5=kick = max(kick * pow(0.82, 60 * dt), hit);
per_frame_6=k60 = pow(0.92, 60 * dt);
per_frame_7=sb = sb * k60 + bass_att * (1 - k60);
per_frame_8=sm = sm * k60 + mid_att * (1 - k60);
per_frame_9=st = st * k60 + treb_att * (1 - k60);
per_frame_10=scroll = scroll + dt * (0.5500 + 0.25 * st + 0.15 * sb + 0.35 * kick);
per_frame_11=dy = -(0.01100 + 0.004 * st + 0.006 * kick);
per_frame_12=ang = ang + dt * (0.0400 + 0.1000 * st);
per_frame_13=hue_shift = 0.5500 + 0.07 * time + 0.15 * st - 0.06 * sb; hue_shift = hue_shift - int(hue_shift);
per_frame_14=wave_r = min(0.2 + 0.7 * sb + 0.4 * kick + 0.2 * sin(time * 1.3), 1);
per_frame_15=wave_g = min(0.25 + 0.55 * sm + 0.3 * st + 0.15 * cos(time * 0.8), 1);
per_frame_16=wave_b = min(0.3 + 0.7 * st + 0.25 * sm, 1);
per_frame_17=q1 = kick; q2 = sb; q3 = sm; q4 = st; q5 = ang;
per_frame_18=q6 = scroll; q7 = 0.5500; q8 = 28.0000; q9 = 6.0000; q10 = 1.1500;
per_frame_19=q11 = hue_shift; q12 = sin(time * 0.41 + st); q13 = 0.85 + 0.2 * (sb + sm + st) * 0.35;
warp_1=`float2 rot2(float2 p, float a)
warp_2=`{
warp_3=`  float c = cos(a); float s = sin(a);
warp_4=`  return float2(c*p.x - s*p.y, s*p.x + c*p.y);
warp_5=`}
warp_6=`float hash11(float n)
warp_7=`{
warp_8=`  return frac(sin(n) * 43758.5453);
warp_9=`}
warp_10=`float3 hue(float h, float s)
warp_11=`{
warp_12=`  float3 k = abs(frac(h + float3(0.0, 0.66667, 0.33333))*6.0 - 3.0) - 1.0;
warp_13=`  return (1.0 - s) + s*saturate(k);
warp_14=`}
warp_15=`float lum_sample(float2 u)
warp_16=`{
warp_17=`  float3 w = float3(0.55, 0.30, 0.12);
warp_18=`  float3 a = tex2D(sampler_main, u).rgb;
warp_19=`  float3 b = GetBlur1(u);
warp_20=`  float3 c = GetBlur2(u);
warp_21=`  return dot(a, w) * 0.55 + dot(b, w) * 0.30 + dot(c, w) * 0.15;
warp_22=`}
warp_23=`float3 jelly_relief(float2 u)
warp_24=`{
warp_25=`  float2 px = texsize.zw;
warp_26=`  float gx = lum_sample(u + float2(px.x, 0.0)) - lum_sample(u - float2(px.x, 0.0));
warp_27=`  float gy = lum_sample(u + float2(0.0, px.y)) - lum_sample(u - float2(0.0, px.y));
warp_28=`  float3 n = normalize(float3(gx, gy, 0.12 + 0.04 * q1));
warp_29=`  float3 rel = 0.5 + 0.5 * n;
warp_30=`  float edge = saturate(length(rel.xy - 0.5) * (4.5 + 2.0 * q4));
warp_31=`  rel *= edge;
warp_32=`  return rel;
warp_33=`}
warp_34=`float3 led_tonemap(float3 col)
warp_35=`{
warp_36=`  float lum = max(dot(col, float3(0.30, 0.59, 0.11)), 0.0001);
warp_37=`  float mapped = 1.0 - exp(-lum * 1.05);
warp_38=`  mapped = min(mapped, 0.90);
warp_39=`  float3 outc = (col / lum) * mapped * q13;
warp_40=`  outc += float3(1.0, 1.0, 1.0) * pow(mapped, 3.0) * q1 * 0.4;
warp_41=`  return saturate(outc);
warp_42=`}
warp_43=`shader_body
warp_44=`{
warp_45=`  float2 suv = lerp(uv, uv_orig, 0.28);
warp_46=`  float3 prev = tex2D(sampler_main, uv).rgb;
warp_47=`  float3 trail = tex2D(sampler_main, suv + float2(0.0, 0.01 + 0.01 * q4)).rgb * 0.94;
warp_48=`  float3 retc = max(prev, trail);
warp_49=`  float2 gid = floor(uv * float2(q8, q8 * 1.35) + float2(q6 * 2.0, -q6 * 6.0));
warp_50=`  float bit = step(0.55 - 0.15 * q2, hash11(dot(gid, float2(12.9898, 78.233)) + floor(q6)));
warp_51=`  float edge = step(0.92, max(frac(uv.x * q8), frac(uv.y * q8 * 1.35)));
warp_52=`  float3 tint = hue(q11 + 0.05 * gid.y * 0.02, 1.0);
warp_53=`  retc += tint * bit * (0.045 + 0.06 * q1) * (1.0 - edge);
warp_54=`  retc += tint * edge * 0.02;
warp_55=`  float3 m = float3(q9, q9, q9 * 1.15);
warp_56=`  retc = lerp(retc, floor(retc * m + 0.2) / m, 0.18);
warp_57=`  retc = retc * 0.99 - 0.0015;
warp_58=`  ret = max(retc, 0.0);
warp_59=`}
comp_1=`float2 rot2(float2 p, float a)
comp_2=`{
comp_3=`  float c = cos(a); float s = sin(a);
comp_4=`  return float2(c*p.x - s*p.y, s*p.x + c*p.y);
comp_5=`}
comp_6=`float hash11(float n)
comp_7=`{
comp_8=`  return frac(sin(n) * 43758.5453);
comp_9=`}
comp_10=`float3 hue(float h, float s)
comp_11=`{
comp_12=`  float3 k = abs(frac(h + float3(0.0, 0.66667, 0.33333))*6.0 - 3.0) - 1.0;
comp_13=`  return (1.0 - s) + s*saturate(k);
comp_14=`}
comp_15=`float lum_sample(float2 u)
comp_16=`{
comp_17=`  float3 w = float3(0.55, 0.30, 0.12);
comp_18=`  float3 a = tex2D(sampler_main, u).rgb;
comp_19=`  float3 b = GetBlur1(u);
comp_20=`  float3 c = GetBlur2(u);
comp_21=`  return dot(a, w) * 0.55 + dot(b, w) * 0.30 + dot(c, w) * 0.15;
comp_22=`}
comp_23=`float3 jelly_relief(float2 u)
comp_24=`{
comp_25=`  float2 px = texsize.zw;
comp_26=`  float gx = lum_sample(u + float2(px.x, 0.0)) - lum_sample(u - float2(px.x, 0.0));
comp_27=`  float gy = lum_sample(u + float2(0.0, px.y)) - lum_sample(u - float2(0.0, px.y));
comp_28=`  float3 n = normalize(float3(gx, gy, 0.12 + 0.04 * q1));
comp_29=`  float3 rel = 0.5 + 0.5 * n;
comp_30=`  float edge = saturate(length(rel.xy - 0.5) * (4.5 + 2.0 * q4));
comp_31=`  rel *= edge;
comp_32=`  return rel;
comp_33=`}
comp_34=`float3 led_tonemap(float3 col)
comp_35=`{
comp_36=`  float lum = max(dot(col, float3(0.30, 0.59, 0.11)), 0.0001);
comp_37=`  float mapped = 1.0 - exp(-lum * 1.05);
comp_38=`  mapped = min(mapped, 0.90);
comp_39=`  float3 outc = (col / lum) * mapped * q13;
comp_40=`  outc += float3(1.0, 1.0, 1.0) * pow(mapped, 3.0) * q1 * 0.4;
comp_41=`  return saturate(outc);
comp_42=`}
comp_43=`shader_body
comp_44=`{
comp_45=`  float3 rel = jelly_relief(uv);
comp_46=`  float3 ink = tex2D(sampler_main, uv).rgb + GetBlur1(uv) * 0.35;
comp_47=`  float3 tint = hue(q11 + ink.y * 0.2, 0.9);
comp_48=`  float3 col = tint * (0.25 + 1.2 * ink) * (0.45 + 0.7 * rel);
comp_49=`  col += float3(0.6, 0.9, 1.0) * pow(rel.z, 3.0) * (0.25 + 0.7 * q1);
comp_50=`  float2 gid = floor(uv * float2(q8, q8 * 1.35));
comp_51=`  float scan = 0.85 + 0.15 * sin(gid.y * 1.7 + time * 8.0 + 3.0 * q4);
comp_52=`  col *= scan;
comp_53=`  ret = led_tonemap(col * q10);
comp_54=`}
