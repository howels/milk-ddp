{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":dependencyDashboard"
  ],
  "labels": ["dependencies"],
  "prConcurrentLimit": 4,
  "packageRules": [
    {
      "description": "Group GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "groupName": "github-actions"
    },
    {
      "description": "Group container base images",
      "matchDatasources": ["docker"],
      "groupName": "docker-base-images"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "libprojectM FetchContent git tag (CMake) and make vendor-projectm branch",
      "fileMatch": ["(^|/)CMakeLists\\.txt$", "(^|/)Makefile$"],
      "matchStrings": [
        "MILKDROP_DDP_PROJECTM_GIT_TAG\\s+\"(?<currentValue>[^\"]+)\"\\s+CACHE",
        "git clone --branch (?<currentValue>v?[0-9][^\\s]*) --depth 1 --recurse-submodules"
      ],
      "datasourceTemplate": "git-tags",
      "packageNameTemplate": "https://github.com/projectM-visualizer/projectm"
    }
  ]
}
